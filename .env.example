DATABASE_URL=postgresql://user:password@localhost:5432/eventslot
DIRECT_URL=postgresql://user:password@localhost:5432/eventslot
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM=

# Preferred production email provider. Use SMTP for organiser campaigns,
# waitlist promotion emails, OTPs, team invites, and admin broadcasts.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventSlot <hello@eventsslot.com>


PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYMENTS_ENABLED=true
NEXT_PUBLIC_PAYMENTS_ENABLED=true

# Redis / Upstash (Optional — distributed sliding-window rate limiting & PIN security)
# When omitted, system safely falls back to local in-memory sliding-window limiters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# EventSlot Assistant (ESA) — Feature Flags
# ─────────────────────────────────────────────────────────────────────────────
# SAFETY: Leave this variable UNSET or set to "false" in all environments.
# When unset or false, the ESA operates in safe dry-run / proposal-only mode:
# it will generate event proposals and show them to the organiser, but will
# NOT execute any event creation, email sending, or calendar actions.
#
# Only set to "true" after explicit written approval from the engineering lead
# AND after verifying the outbox processor and idempotency guarantees in staging.
#
# ESA_LIVE_EVENT_CREATION_ENABLED=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 Object Storage
# ─────────────────────────────────────────────────────────────────────────────
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=eventsslot
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# (Optional) Dedicated private bucket for confidential candidate resumes/portfolios.
# When omitted, system defaults to private prefix in R2_BUCKET_NAME.
# RECRUITMENT_R2_BUCKET_NAME=eventslot-recruitment-private
