DATABASE_URL=postgresql://user:password@localhost:5432/eventslot
DIRECT_URL=postgresql://user:password@localhost:5432/eventslot
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM=

# Preferred production email provider. Use SMTP for organiser campaigns,
# waitlist promotion emails, OTPs, team invites, and admin broadcasts.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventSlot <hello@eventsslot.com>


PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYMENTS_ENABLED=true
NEXT_PUBLIC_PAYMENTS_ENABLED=true

# Redis / Upstash (Optional — distributed sliding-window rate limiting & PIN security)
# When omitted, system safely falls back to local in-memory sliding-window limiters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
