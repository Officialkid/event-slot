// Prisma schema file

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id               String    @id @default(cuid())
  title            String
  description      String?
  slug             String    @unique
  capacity         Int?
  deadline         DateTime?
  confirmedCount   Int       @default(0)
  waitlistCount    Int       @default(0)
  organizerEmail   String
  dashboardToken   String    @unique
  questions        Json
  createdAt        DateTime  @default(now())
  organizerId      String?
  organizer        User?     @relation(fields: [organizerId], references: [id])
  eventDate        DateTime?
  joinOpensAt      DateTime?
  location         String?
  communityLink    String?
  eventType        EventType @default(PHYSICAL)
  virtualLink      String?
  virtualLinkIv    String?
  imageUrl         String?
  archived         Boolean   @default(false)
  status           String    @default("active")
  isPaid           Boolean   @default(false)
  ticketPrice      Int?
  currency         String    @default("KSh")
  paymentsLive     Boolean   @default(false)
  ticketsEnabled   Boolean   @default(true)
  feedbackSent     Boolean   @default(false)
  reminderSent     Boolean   @default(false)
  dataExpired      Boolean   @default(false)
  expiresAt        DateTime?
  countryCode      String?   // ISO 3166-1 alpha-2 — country detected when event was created
  registrations    Registration[]
  views            EventView[]
  feedback         AttendeeFeedback[]
  unlocks          EventUnlock[]
  insight          EventInsight?
  entryLogs        EntryLog[]
  teamAccess       TeamMemberEvent[]
  emailCampaigns   EmailCampaign[]
}

enum EventType {
  PHYSICAL
  VIRTUAL
}

model EntryLog {
  id           String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketId      String
  attendeeName  String
  scannedAt     DateTime @default(now())
  success       Boolean
  failReason    String?
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  createdAt      DateTime       @default(now())
  plan           String         @default("free")
  planStartDate  DateTime?
  planEndDate    DateTime?
  isAdmin        Boolean        @default(false)
  billingCycle   String?
  suspended      Boolean        @default(false)
  paystackCustomerCode     String?  @unique
  paystackSubscriptionCode String?  @unique
  creditBalance            Float    @default(0)
  signupCountry            String?  // ISO 3166-1 alpha-2 — set at signup, never changes
  countryCode              String?  // most recently detected country
  countryName              String?
  username                 String?  @unique
  resetToken               String?
  resetTokenExpiry         DateTime?
  consentSystemEmails      Boolean   @default(false)
  marketingConsent         Boolean   @default(false)
  onboardingCompleted      Boolean   @default(false)
  onboardingStep           Int       @default(0)
  onboardingSkipped        Boolean   @default(false)
  accounts       Account[]
  ownedTeam      TeamMember[] @relation("OwnedTeam")
  memberOf       TeamMember[] @relation("MemberOf")
  sessions       Session[]
  events         Event[]
  onboarding     UserOnboarding?
  notifications  Notification[]
  creditTransactions CreditTransaction[]
  featureAccess      FeatureAccess[]
  organizerFeedback  OrganizerFeedback[]
  messages           Message[]
  reportDownload     ReportDownload?
  tokenBalance       TokenBalance?
  tokenTransactions  TokenTransaction[]
  voiceQuota         VoiceQuota?
  memoryPreference   UserMemoryPreference?
  memory             UserMemory?
  referralLink       ReferralLink?
  referralsMade      Referral[]          @relation("ReferralsMade")
  referredBy         Referral?           @relation("ReferredBy")
  pioneerBadge       PioneerBadge?
  badges             UserBadge[]
  leaderboardEntries         LeaderboardEntry[]
  weeklyRankingNotifications WeeklyRankingNotification[]
}

model ReferralLink {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String     @unique
  clicks    Int        @default(0)
  createdAt DateTime   @default(now())
  referrals Referral[]
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referrer       User           @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredUserId String         @unique
  referredUser   User           @relation("ReferredBy", fields: [referredUserId], references: [id])
  linkId         String
  link           ReferralLink   @relation(fields: [linkId], references: [id])
  status         ReferralStatus @default(SIGNED_UP)
  signupTokens   Int            @default(0)
  eventTokens    Int            @default(0)
  totalEarned    Int            @default(0)
  createdAt      DateTime       @default(now())
  eventCreatedAt DateTime?
}

enum ReferralStatus {
  SIGNED_UP
  EVENT_CREATED
}

model PioneerBadge {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hasSeenCongratulations Boolean @default(false)
  awardedAt             DateTime @default(now())
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     BadgeType
  awardedAt DateTime  @default(now())

  @@unique([userId, badge])
}

model LeaderboardEntry {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  period        String     // "2025-W21" | "2025-05" | "all-time"
  periodType    PeriodType
  referralPts   Int        @default(0)
  organiserPts  Int        @default(0)
  totalPts      Int        @default(0)
  referralRank  Int?
  organiserRank Int?
  overallRank   Int?
  calculatedAt  DateTime   @default(now())

  @@unique([userId, period])
  @@index([period, totalPts])
}

model WeeklyRankingNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey   String    // "2025-W21"
  rank      Int
  totalPts  Int
  seen      Boolean   @default(false)
  sharedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, weekKey])
}

enum BadgeType {
  PIONEER
  GROWTH_BUILDER
  COMMUNITY_CHAMPION
  HALL_OF_FAME
  STARRED_ORGANIZER
  COMMUNITY_BUILDER
}

enum PeriodType {
  WEEK
  MONTH
  ALL_TIME
}

model UserOnboarding {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedSteps    String[] @default([])
  usedFeatures      String[] @default([])
  tutorialCompleted Boolean  @default(false)
  tutorialSkipped   Boolean  @default(false)
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserMemoryPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryEnabled Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model UserMemory {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary      String   @db.Text
  keyFacts     Json
  sessionCount Int      @default(0)
  lastUpdated  DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, otp])
}

model Registration {
  id                    String    @id @default(cuid())
  eventId               String
  event                 Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers               Json
  status                String
  waitlistPosition      Int?
  registrationNumber    Int?
  submittedAt           DateTime  @default(now())
  notified              Boolean   @default(false)
  attendeeEmail         String?
  consentTransactional  Boolean   @default(false)
  consentMarketing      Boolean   @default(false)
  isDuplicate           Boolean   @default(false)
  checkedIn             Boolean   @default(false)
  checkedInAt           DateTime?
  qrCode                String?   @unique
  confirmationCode      String?   @unique
  source                String    @default("form")
  countryCode           String?   // ISO 3166-1 alpha-2 — country detected when attendee registered
  ticket                Ticket?
}

model Ticket {
  id             String        @id @default(cuid())
  code           String        @unique @default(cuid())
  registrationId String        @unique
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  generatedAt    DateTime      @default(now())
  scannedAt      DateTime?
  createdAt      DateTime      @default(now())
}

model ErrorLog {
  id        String   @id @default(cuid())
  route     String
  message   String
  createdAt DateTime @default(now())
}

enum MessageType {
  USER_FEEDBACK
  ADMIN_BROADCAST
}

model Message {
  id        String       @id @default(cuid())
  type      MessageType
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id])
  subject   String
  content   String       @db.Text
  isPublic  Boolean      @default(false)
  createdAt DateTime     @default(now())
}

enum NotificationType {
  EVENT
  PLATFORM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  description String
  reference   String?
  eventId     String?
  createdAt   DateTime @default(now())
}

model EventUnlock {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  feature    String
  unlockedAt DateTime @default(now())
}

model OrganizerFeedback {
  id          String   @id @default(cuid())
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id])
  type        String   // "complaint" | "compliment" | "suggestion" | "general"
  subject     String
  message     String
  rating      Int?
  status      String   @default("unread")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventView {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  source   String?
}

model AttendeeFeedback {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String   @unique
  rating         Int
  enjoyed        String?
  improve        String?
  complaint      String?
  submittedAt    DateTime @default(now())
}

model TeamMember {
  id          String            @id @default(cuid())
  ownerId     String
  owner       User              @relation("OwnedTeam", fields: [ownerId], references: [id], onDelete: Cascade)
  memberId    String?
  member      User?             @relation("MemberOf", fields: [memberId], references: [id], onDelete: SetNull)
  email       String
  status      String            @default("pending")
  inviteToken String            @unique
  createdAt   DateTime          @default(now())
  eventAccess TeamMemberEvent[]
}

model TeamMemberEvent {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([teamMemberId, eventId])
}

model EventInsight {
  id          String   @id @default(cuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cards       Json
  generatedAt DateTime @default(now())
}

model FeatureAccess {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  feature   String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model FeatureInterest {
  id          String   @id @default(cuid())
  email       String
  featureName String
  createdAt   DateTime @default(now())

  @@unique([email, featureName])
}

model ReportDownload {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloadsRemaining Int      @default(0)
  totalPurchased     Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ReportDownloadTransaction {
  id          String   @id @default(cuid())
  userId      String
  bundleKey   String
  amountKsh   Int
  downloads   Int
  reference   String   @unique
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}

model AssistantSession {
  id            String             @id @default(cuid())
  ipHash        String
  userId        String?
  label         String?
  userAgent     String?
  channel       SessionChannel     @default(TEXT)
  status        SessionStatus      @default(ACTIVE)
  flagged       Boolean            @default(false)
  flagReason    String?
  messageCount  Int                @default(0)
  imageCount    Int                @default(0)
  offTopicCount Int                @default(0)
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  messages      AssistantMessage[]
}

model ChatQuota {
  id          String   @id @default(cuid())
  identifier  String   @unique
  creditsUsed Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssistantFeedback {
  id         String   @id @default(cuid())
  identifier String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model AssistantMessage {
  id        String           @id @default(cuid())
  sessionId String
  session   AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String           @db.Text
  isVoice   Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum SessionChannel {
  TEXT
  VOICE
}

enum SessionStatus {
  ACTIVE
  ENDED
  FLAGGED
}

enum MessageRole {
  USER
  ASSISTANT
}

model TokenBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model TokenTransaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  description   String
  referenceId   String?
  createdAt     DateTime        @default(now())
}

model VoiceQuota {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedThisMonth Int      @default(0)
  resetAt       DateTime
  updatedAt     DateTime @updatedAt
}

model RateLimitLog {
  id        String   @id @default(cuid())
  key       String
  action    String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum TransactionType {
  PURCHASE
  DEBIT
  REFUND
  ADMIN_GRANT
  BONUS
  MONTHLY_VOICE
}

// ── Email Campaigns ────────────────────────────────────────────────────────

model EmailCampaign {
  id             String              @id @default(cuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organiserId    String
  subject        String
  body           String              @db.Text
  type           EmailCampaignType   @default(CUSTOM)
  status         EmailCampaignStatus @default(DRAFT)
  sentAt         DateTime?
  recipientCount Int?
  createdAt      DateTime            @default(now())
}

enum EmailCampaignType {
  REMINDER
  UPDATE
  THANK_YOU
  CUSTOM
}

enum EmailCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// ── Exchange Rates ─────────────────────────────────────────────────────────

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique
  rate      Float    // rate relative to USD (e.g. KES = 130)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Country Intelligence ───────────────────────────────────────────────────

model CountrySnapshot {
  id             String   @id @default(cuid())
  countryCode    String
  countryName    String
  userCount      Int
  organizerCount Int
  eventCount     Int
  snapshotDate   DateTime @db.Date
  createdAt      DateTime @default(now())

  @@unique([countryCode, snapshotDate])
}
