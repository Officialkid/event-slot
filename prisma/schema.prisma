// Prisma schema file

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id               String    @id @default(cuid())
  isTestData       Boolean   @default(false)
  title            String
  description      String?
  slug             String    @unique
  accessType       EventAccessType @default(REGISTRATION)
  capacity         Int?
  deadline         DateTime?
  confirmedCount   Int       @default(0)
  waitlistCount    Int       @default(0)
  organizerEmail   String
  dashboardToken   String    @unique
  verifierCode     String?   @unique
  verifierCodeEnabled Boolean @default(true)
  questions        Json
  createdAt        DateTime  @default(now())
  organizerId      String?
  organizer        User?     @relation(fields: [organizerId], references: [id])
  eventDate        DateTime?
  eventEndAt       DateTime?
  joinOpensAt      DateTime?
  location         String?
  communityLink    String?
  eventType        EventType @default(PHYSICAL)
  virtualLink      String?
  virtualLinkIv    String?
  imageUrl         String?
  archived         Boolean   @default(false)
  status           String    @default("active")
  isPaid           Boolean   @default(false)
  ticketPrice      Int?
  currency         String    @default("KSh")
  paymentsLive     Boolean   @default(false)
  ticketsEnabled   Boolean   @default(true)
  feedbackSent     Boolean   @default(false)
  reminderSent     Boolean   @default(false)
  dataExpired      Boolean   @default(false)
  expiresAt        DateTime?
  countryCode      String?   // ISO 3166-1 alpha-2 — country detected when event was created
  category         String?   // e.g. CONFERENCE, WORKSHOP, NETWORKING, CHURCH, CAMPUS, CONCERT, VIRTUAL
  faqEnabled       Boolean   @default(false)
  aiInsightsFreeUsed Boolean @default(false)
  whatsappNumber   String?   // stored without formatting, e.g. "254712345678"
  summaryEmailSent Boolean   @default(false)
  ticketTiers      TicketTier[]
  paidOrders       PaidEventOrder[]
  payments         Payment[]
  registrations    Registration[]
  registrationDrafts RegistrationDraft[]
  walkInCheckins   WalkInCheckin[]
  views            EventView[]
  feedback         AttendeeFeedback[]
  unlocks          EventUnlock[]
  insight          EventInsight?
  entryLogs        EntryLog[]
  teamAccess       TeamMemberEvent[]
  emailCampaigns   EmailCampaign[]
  faqs             EventFAQ[]
  calendarSyncs    CalendarEventSync[]
  eventPass        EventPass?
}

model EventFAQ {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventType {
  PHYSICAL
  VIRTUAL
}

enum EventAccessType {
  REGISTRATION
  WALK_IN
}

model WalkInCheckin {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  dayDate   DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([eventId, phone, dayDate])
  @@index([eventId, dayDate])
}

model EntryLog {
  id           String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketId      String
  attendeeName  String
  scannedAt     DateTime @default(now())
  success       Boolean
  failReason    String?
}

model User {
  id             String         @id @default(cuid())
  isTestData     Boolean        @default(false)
  name           String?
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  createdAt      DateTime       @default(now())
  plan           String         @default("free")
  planStartDate  DateTime?
  planEndDate    DateTime?
  isAdmin        Boolean        @default(false)
  billingCycle   String?
  suspended      Boolean        @default(false)
  paystackCustomerCode     String?  @unique
  paystackSubscriptionCode String?  @unique
  creditBalance            Float    @default(0)
  signupCountry            String?  // ISO 3166-1 alpha-2 — set at signup, never changes
  countryCode              String?  // most recently detected country
  countryName              String?
  preferredLanguage        String   @default("en")
  username                 String?  @unique
  resetToken               String?
  resetTokenExpiry         DateTime?
  consentSystemEmails      Boolean   @default(false)
  marketingConsent         Boolean   @default(false)
  twoFactorEnabled         Boolean   @default(false)
  otpRequired              Boolean   @default(false)
  paymentPinHash           String?
  paymentPinEnabled        Boolean   @default(false)
  paymentPinUpdatedAt      DateTime?
  googleCalendarConnected  Boolean   @default(false)
  onboardingCompleted      Boolean   @default(false)
  onboardingStep           Int       @default(0)
  onboardingSkipped        Boolean   @default(false)
  accounts       Account[]
  ownedTeam      TeamMember[] @relation("OwnedTeam")
  memberOf       TeamMember[] @relation("MemberOf")
  sessions       Session[]
  events         Event[]
  onboarding     UserOnboarding?
  notifications  Notification[]
  creditTransactions CreditTransaction[]
  featureAccess      FeatureAccess[]
  organizerFeedback  OrganizerFeedback[]
  messages           Message[]
  reportDownload     ReportDownload?
  billingLaunchInterests BillingLaunchInterest[]
  tokenBalance       TokenBalance?
  tokenTransactions  TokenTransaction[]
  voiceQuota         VoiceQuota?
  memoryPreference   UserMemoryPreference?
  memory             UserMemory?
  referralLink       ReferralLink?
  referralsMade      Referral[]          @relation("ReferralsMade")
  referredBy         Referral?           @relation("ReferredBy")
  pioneerBadge       PioneerBadge?
  badges             UserBadge[]
  leaderboardEntries         LeaderboardEntry[]
  weeklyRankingNotifications WeeklyRankingNotification[]
  googleCalendarToken        GoogleCalendarToken?
  calendarEventSyncs         CalendarEventSync[]
  subscriptions              Subscription[]
  eventPasses                EventPass[]
  paygSettings               PaygSettings?
  organiserBalance           OrganiserBalance?
  withdrawals                Withdrawal[]
}

model LoginSecurityState {
  id             String   @id @default(cuid())
  email          String   @unique
  failedAttempts Int      @default(0)
  lastFailedAt   DateTime?
  lockedUntil    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ReferralLink {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String     @unique
  clicks    Int        @default(0)
  createdAt DateTime   @default(now())
  referrals Referral[]
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referrer       User           @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredUserId String         @unique
  referredUser   User           @relation("ReferredBy", fields: [referredUserId], references: [id])
  linkId         String
  link           ReferralLink   @relation(fields: [linkId], references: [id])
  status         ReferralStatus @default(SIGNED_UP)
  signupTokens   Int            @default(0)
  eventTokens    Int            @default(0)
  totalEarned    Int            @default(0)
  createdAt      DateTime       @default(now())
  eventCreatedAt DateTime?
}

enum ReferralStatus {
  SIGNED_UP
  EVENT_CREATED
}

model PioneerBadge {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hasSeenCongratulations Boolean @default(false)
  awardedAt             DateTime @default(now())
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     BadgeType
  awardedAt DateTime  @default(now())

  @@unique([userId, badge])
}

model LeaderboardEntry {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  period        String     // "2025-W21" | "2025-05" | "all-time"
  periodType    PeriodType
  referralPts   Int        @default(0)
  organiserPts  Int        @default(0)
  totalPts      Int        @default(0)
  referralRank  Int?
  organiserRank Int?
  overallRank   Int?
  calculatedAt  DateTime   @default(now())

  @@unique([userId, period])
  @@index([period, totalPts])
}

model WeeklyRankingNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey   String    // "2025-W21"
  rank      Int
  totalPts  Int
  seen      Boolean   @default(false)
  sharedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, weekKey])
}

enum BadgeType {
  PIONEER
  GROWTH_BUILDER
  COMMUNITY_CHAMPION
  HALL_OF_FAME
  STARRED_ORGANIZER
  COMMUNITY_BUILDER
}

enum PeriodType {
  WEEK
  MONTH
  ALL_TIME
}

model UserOnboarding {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedSteps    String[] @default([])
  usedFeatures      String[] @default([])
  tutorialCompleted Boolean  @default(false)
  tutorialSkipped   Boolean  @default(false)
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserMemoryPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryEnabled Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model UserMemory {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary      String   @db.Text
  keyFacts     Json
  sessionCount Int      @default(0)
  lastUpdated  DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, otp])
}

model Registration {
  id                    String    @id @default(cuid())
  isTestData            Boolean   @default(false)
  eventId               String
  event                 Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers               Json
  status                String
  waitlistPosition      Int?
  registrationNumber    Int?
  submittedAt           DateTime  @default(now())
  notified              Boolean   @default(false)
  attendeeEmail         String?
  consentDataProcessing Boolean   @default(false)
  consentTransactional  Boolean   @default(false)
  consentMarketing      Boolean   @default(false)
  isDuplicate           Boolean   @default(false)
  checkedIn             Boolean   @default(false)
  checkedInAt           DateTime?
  qrCode                String?   @unique
  confirmationCode      String?   @unique
  source                String    @default("form")
  refCode               String?
  utmSource             String?
  countryCode           String?   // ISO 3166-1 alpha-2 — country detected when attendee registered
  ticketTierId          String?
  ticketTier            TicketTier? @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  paidOrderId           String?
  paidOrder             PaidEventOrder? @relation(fields: [paidOrderId], references: [id], onDelete: SetNull)
  ticket                Ticket?
  payment               Payment?

  @@index([eventId, status])
  @@index([eventId, submittedAt])
  @@index([eventId, waitlistPosition])
}

model RegistrationDraft {
  id                    String   @id @default(cuid())
  eventId               String
  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email                 String
  answers               Json
  attendeeCount         Int      @default(1)
  baseEmails            Json?
  consentDataProcessing Boolean  @default(false)
  consentTransactional  Boolean  @default(false)
  consentMarketing      Boolean  @default(false)
  sendResponseCopy      Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([eventId, email])
  @@index([email])
}

model TicketTier {
  id                 String             @id @default(cuid())
  eventId            String
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name               String
  presetKey          String?
  badgeColor         String             @default("#A8A9AD")
  textColor          String             @default("#1A1A1A")
  metallic           Boolean            @default(false)
  prestige           Int                @default(0)
  priceKes           Int
  currency           String             @default("KES")
  capacity           Int
  description        String?
  sortOrder          Int                @default(0)
  bundleSize         Int                @default(1)
  status             TicketTierStatus   @default(ACTIVE)
  soldCount          Int                @default(0)
  waitlistCount      Int                @default(0)
  registrations      Registration[]
  paidOrders         PaidEventOrder[]
  tickets            Ticket[]
  payments           Payment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([eventId, sortOrder])
}

enum TicketTierStatus {
  ACTIVE
  ARCHIVED
}

model PaidEventOrder {
  id                    String               @id @default(cuid())
  eventId               String
  event                 Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTierId          String
  ticketTier            TicketTier           @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)
  status                PaidOrderStatus      @default(PENDING)
  paymentMethod         PaidOrderPaymentMethod
  attendeePayload       Json
  attendeeEmail         String?
  attendeeName          String?
  attendeePhone         String?
  amountKes             Int
  currency              String               @default("KES")
  holdExpiresAt         DateTime
  checkoutRequestId     String?              @unique
  providerReference     String?
  mpesaReceiptNumber    String?
  mpesaPhone            String?
  paidAt                DateTime?
  cancelledAt           DateTime?
  promotionRegistrationId String?
  registrations         Registration[]
  payment               Payment?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([eventId, status])
  @@index([ticketTierId, status])
  @@index([holdExpiresAt])
}

enum PaidOrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
}

enum PaidOrderPaymentMethod {
  MPESA
  CARD
}

model Ticket {
  id             String        @id @default(cuid())
  isTestData     Boolean       @default(false)
  code           String        @unique @default(cuid())
  registrationId String        @unique
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  ticketTierId   String?
  ticketTier     TicketTier?   @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  ticketTierName String?
  amountPaidKes  Int?
  admissionsTotal Int          @default(1)
  admissionsUsed  Int          @default(0)
  verifiedEntries Json?
  generatedAt    DateTime      @default(now())
  scannedAt      DateTime?
  createdAt      DateTime      @default(now())
  payment        Payment?
}

model Payment {
  id                String               @id @default(cuid())
  isTestData        Boolean              @default(false)
  eventId           String
  event             Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paidEventOrderId  String               @unique
  paidEventOrder    PaidEventOrder       @relation(fields: [paidEventOrderId], references: [id], onDelete: Cascade)
  registrationId    String?              @unique
  registration      Registration?        @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  ticketId          String?              @unique
  ticket            Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  ticketTierId      String?
  ticketTier        TicketTier?          @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)
  amount            Int
  commissionAmount  Int
  organizerAmount   Int
  commissionRate    Float
  method            PaidOrderPaymentMethod
  mpesaRef          String?
  status            PaymentStatus        @default(PENDING)
  createdAt         DateTime             @default(now())
  paidAt            DateTime?

  @@index([eventId, status])
  @@index([ticketTierId, status])
}

model EventPass {
  id               String            @id @default(cuid())
  eventId           String            @unique
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizerId       String
  organizer         User              @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  tier              OneTimePassTier
  status            EventPassStatus   @default(PENDING)
  priceUsd          Float
  priceKes          Int
  commissionRate    Float
  paymentMethod     PaidOrderPaymentMethod
  paymentProvider   String?
  paymentReference  String?
  checkoutRequestId String?           @unique
  activatedAt       DateTime?
  expiresAt         DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  payments          EventPassPayment[]

  @@index([organizerId, status])
  @@index([status, expiresAt])
}

model EventPassPayment {
  id                String        @id @default(cuid())
  eventPassId       String
  eventPass         EventPass     @relation(fields: [eventPassId], references: [id], onDelete: Cascade)
  amountKes         Float
  amountUsd         Float
  exchangeRate      Float
  provider          String
  providerRef       String?
  checkoutRequestId String?
  status            PaymentStatus @default(PENDING)
  phone             String?
  description       String?       @db.Text
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  @@index([eventPassId])
  @@index([checkoutRequestId])
}

model OrganiserBalance {
  id            String   @id @default(cuid())
  organiserId   String   @unique
  organiser     User     @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  grossKES      Float    @default(0)
  commissionKES Float    @default(0)
  netKES        Float    @default(0)
  withdrawnKES  Float    @default(0)
  grossUSD      Float    @default(0)
  commissionUSD Float    @default(0)
  netUSD        Float    @default(0)
  withdrawnUSD  Float    @default(0)
  updatedAt     DateTime @updatedAt
}

model Withdrawal {
  id          String           @id @default(cuid())
  organiserId String
  organiser   User             @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String
  method      WithdrawalMethod
  destination String
  status      WithdrawalStatus @default(PROCESSING)
  providerRef String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([organiserId, currency, createdAt])
  @@index([organiserId, status])
}

model ErrorLog {
  id        String   @id @default(cuid())
  route     String
  message   String
  createdAt DateTime @default(now())

  @@index([route, createdAt])
}

enum MessageType {
  USER_FEEDBACK
  ADMIN_BROADCAST
}

model Message {
  id        String       @id @default(cuid())
  type      MessageType
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id])
  subject   String
  content   String       @db.Text
  isPublic  Boolean      @default(false)
  createdAt DateTime     @default(now())
}

enum NotificationType {
  EVENT
  PLATFORM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  description String
  reference   String?
  eventId     String?
  createdAt   DateTime @default(now())
}

model EventUnlock {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  feature    String
  unlockedAt DateTime @default(now())
}

model OrganizerFeedback {
  id          String   @id @default(cuid())
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id])
  type        String   // "complaint" | "compliment" | "suggestion" | "general"
  subject     String
  message     String
  rating      Int?
  status      String   @default("unread")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventView {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  source   String?

  @@index([eventId, viewedAt])
}

model AttendeeFeedback {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String   @unique
  rating         Int
  enjoyed        String?
  improve        String?
  complaint      String?
  submittedAt    DateTime @default(now())

  @@index([eventId, submittedAt])
}

model TeamMember {
  id          String            @id @default(cuid())
  ownerId     String
  owner       User              @relation("OwnedTeam", fields: [ownerId], references: [id], onDelete: Cascade)
  memberId    String?
  member      User?             @relation("MemberOf", fields: [memberId], references: [id], onDelete: SetNull)
  email       String
  status      String            @default("pending")
  inviteToken String            @unique
  createdAt   DateTime          @default(now())
  eventAccess TeamMemberEvent[]
}

model TeamMemberEvent {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([teamMemberId, eventId])
}

model EventInsight {
  id          String   @id @default(cuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cards       Json
  generatedAt DateTime @default(now())
}

model FeatureAccess {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  feature   String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model FeatureInterest {
  id          String   @id @default(cuid())
  email       String
  featureName String
  createdAt   DateTime @default(now())

  @@unique([email, featureName])
}

model BillingLaunchInterest {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String   @unique
  name        String?
  accountType String?
  previewMode String?
  source      String   @default("billing_coming_soon_banner")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model ReportDownload {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloadsRemaining Int      @default(0)
  totalPurchased     Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ReportDownloadTransaction {
  id          String   @id @default(cuid())
  userId      String
  bundleKey   String
  amountKsh   Int
  downloads   Int
  reference   String   @unique
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}

model AssistantSession {
  id            String             @id @default(cuid())
  ipHash        String
  userId        String?
  label         String?
  userAgent     String?
  channel       SessionChannel     @default(TEXT)
  status        SessionStatus      @default(ACTIVE)
  flagged       Boolean            @default(false)
  flagReason    String?
  messageCount  Int                @default(0)
  imageCount    Int                @default(0)
  offTopicCount Int                @default(0)
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  messages      AssistantMessage[]
}

model ChatQuota {
  id          String   @id @default(cuid())
  identifier  String   @unique
  creditsUsed Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssistantFeedback {
  id         String   @id @default(cuid())
  identifier String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model AssistantMessage {
  id        String           @id @default(cuid())
  sessionId String
  session   AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String           @db.Text
  isVoice   Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum SessionChannel {
  TEXT
  VOICE
}

enum SessionStatus {
  ACTIVE
  ENDED
  FLAGGED
}

enum MessageRole {
  USER
  ASSISTANT
}

model TokenBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model TokenTransaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  description   String
  referenceId   String?
  createdAt     DateTime        @default(now())
}

model VoiceQuota {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedThisMonth Int      @default(0)
  resetAt       DateTime
  updatedAt     DateTime @updatedAt
}

model RateLimitLog {
  id        String   @id @default(cuid())
  key       String
  action    String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum TransactionType {
  PURCHASE
  DEBIT
  REFUND
  ADMIN_GRANT
  BONUS
  MONTHLY_VOICE
}

// ── Email Campaigns ────────────────────────────────────────────────────────

model EmailCampaign {
  id             String              @id @default(cuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organiserId    String
  subject        String
  body           String              @db.Text
  type           EmailCampaignType   @default(CUSTOM)
  status         EmailCampaignStatus @default(DRAFT)
  sentAt         DateTime?
  recipientCount Int?
  failureReason  String?
  createdAt      DateTime            @default(now())
}

enum EmailCampaignType {
  REMINDER
  UPDATE
  THANK_YOU
  CUSTOM
}

enum EmailCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// ── Exchange Rates ─────────────────────────────────────────────────────────

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique
  rate      Float    // rate relative to USD (e.g. KES = 130)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Country Intelligence ───────────────────────────────────────────────────

model CountrySnapshot {
  id             String   @id @default(cuid())
  countryCode    String
  countryName    String
  userCount      Int
  organizerCount Int
  eventCount     Int
  snapshotDate   DateTime @db.Date
  createdAt      DateTime @default(now())

  @@unique([countryCode, snapshotDate])
}

// ── Google Calendar Integration ────────────────────────────────────────────

model GoogleCalendarToken {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String   @db.Text
  refreshToken  String   @db.Text
  expiresAt     DateTime
  scope         String
  connected     Boolean  @default(true)
  connectedAt   DateTime @default(now())
  lastUsedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CalendarEventSync {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  googleEventId String
  calendarId    String   @default("primary")
  role          String   // 'organiser' | 'attendee'
  lastSyncedAt  DateTime @default(now())
  syncStatus    String   @default("synced") // 'synced' | 'pending' | 'failed'
  createdAt     DateTime @default(now())

  @@unique([userId, eventId, role])
}

// ─── Subscription Plans (seeded, not user-created) ───────────────────────────
model Plan {
  id                     String         @id @default(cuid())
  name                   String         @unique // "free" | "standard" | "pro" | "business"
  displayName            String
  monthlyPriceUsd        Float
  annualPriceUsd         Float
  // Limits (-1 = unlimited)
  maxAttendeesPerEvent   Int
  maxWaitlistPerEvent    Int
  maxActiveEvents        Int
  maxOrganizerSeats      Int
  dataRetentionDays      Int
  paidEventCommission    Float
  // Feature flags
  hasWaitlist            Boolean        @default(false)
  hasPdfTickets          Boolean        @default(false)
  hasQrCheckin           Boolean        @default(false)
  hasBasicAnalytics      Boolean        @default(false)
  hasFullAnalytics       Boolean        @default(false)
  hasAiInsights          Boolean        @default(false)
  freeAiInsightsPerMonth Int            @default(0)
  hasAiReports           Boolean        @default(false)
  hasEmailCampaigns      Boolean        @default(false)
  hasCustomBranding      Boolean        @default(false)
  hasCustomDomain        Boolean        @default(false)
  hasFaqSystem           Boolean        @default(false)
  hasRecurringEvents     Boolean        @default(false)
  hasApiAccess           Boolean        @default(false)
  hasPrioritySupport     Boolean        @default(false)
  hasPayg                Boolean        @default(true)
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  subscriptions          Subscription[]
}

// ─── User Subscriptions ───────────────────────────────────────────────────────
model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  billingCycle       BillingCycle       @default(MONTHLY)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  paymentProvider    String?
  mpesaPhone         String?
  lastPaymentRef     String?
  lastPaymentAmount  Float?
  lastPaymentAt      DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  payments           SubscriptionPayment[]

  @@index([userId])
  @@index([status])
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum OneTimePassTier {
  STANDARD
  PRO
  BUSINESS
}

enum EventPassStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

// ─── Individual payment records ───────────────────────────────────────────────
model SubscriptionPayment {
  id                String        @id @default(cuid())
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id])
  amountKes         Float
  amountUsd         Float
  exchangeRate      Float
  provider          String
  providerRef       String?
  checkoutRequestId String?
  status            PaymentStatus @default(PENDING)
  phone             String?
  description       String?       @db.Text
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  @@index([subscriptionId])
  @@index([checkoutRequestId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// ─── PAYG opt-in and settings per user ───────────────────────────────────────
enum WithdrawalMethod {
  MPESA
  PAYBILL
  BANK
}

enum WithdrawalStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model PaygSettings {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled       Boolean      @default(false)
  monthlyCapUsd   Float        @default(10.0)
  mpesaPhone      String?
  paymentProvider String?
  billingAuthorizationAccepted Boolean @default(false)
  billingAuthorizedAt DateTime?
  cardholderName  String?
  billingCardBrand String?
  billingCardLast4 String?
  billingCardExpiryMonth Int?
  billingCardExpiryYear Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  usageRecords    PaygUsage[]
  invoices        PaygInvoice[]
}

// ─── Individual PAYG usage events ────────────────────────────────────────────
model PaygUsage {
  id             String        @id @default(cuid())
  paygSettingsId String
  paygSettings   PaygSettings  @relation(fields: [paygSettingsId], references: [id])
  userId         String
  billingMonth   String
  usageType      PaygUsageType
  quantity       Float         @default(1)
  unitCostUsd    Float
  totalCostUsd   Float
  description    String?
  eventId        String?
  createdAt      DateTime      @default(now())

  @@index([userId, billingMonth])
}

enum PaygUsageType {
  EXTRA_ATTENDEE
  EXTRA_EVENT
  EXTRA_SEAT
  AI_INSIGHT
  AI_REPORT
  EMAIL_SEND
  DATA_RETENTION
}

// ─── Monthly PAYG invoices ────────────────────────────────────────────────────
model PaygInvoice {
  id             String        @id @default(cuid())
  paygSettingsId String
  paygSettings   PaygSettings  @relation(fields: [paygSettingsId], references: [id])
  userId         String
  billingMonth   String
  totalAmountUsd Float
  totalAmountKes Float
  status         InvoiceStatus @default(UNPAID)
  dueAt          DateTime
  paidAt         DateTime?
  providerRef    String?
  createdAt      DateTime      @default(now())

  @@index([userId, billingMonth])
}

enum InvoiceStatus {
  UNPAID
  PAID
  FAILED
  WAIVED
}
