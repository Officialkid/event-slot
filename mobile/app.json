{
  "expo": {
    "name": "EventSlot",
    "slug": "eventslot-native",
    "scheme": "eventslot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "privacy": "unlisted",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#050806"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphatech.eventslot.native",
      "infoPlist": {
        "NSCameraUsageDescription": "EventSlot uses the camera to scan attendee ticket QR codes at events.",
        "NSPhotoLibraryUsageDescription": "EventSlot lets organizers and attendees select images or documents when an event form requests an upload."
      }
    },
    "android": {
      "package": "com.alphatech.eventslot.native",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B9FF3B"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "EventSlot uses the camera to scan attendee ticket QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B9FF3B",
          "defaultChannel": "eventslot-default"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://www.eventsslot.com"
    }
  }
}
