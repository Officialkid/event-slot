{
  "expo": {
    "name": "EventSlot",
    "slug": "eventslot",
    "scheme": "eventslot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "privacy": "unlisted",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alphatech.eventslot",
      "infoPlist": {
        "NSCameraUsageDescription": "EventSlot uses the camera to scan attendee ticket QR codes at events.",
        "NSPhotoLibraryUsageDescription": "EventSlot lets organizers and attendees select images or documents when an event form requests an upload."
      }
    },
    "android": {
      "package": "com.alphatech.eventslot",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B9FF3B"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.eventsslot.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "EventSlot uses the camera to scan attendee ticket QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B9FF3B",
          "defaultChannel": "eventslot-default"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiBaseUrl": "https://www.eventsslot.com"
    }
  }
}
