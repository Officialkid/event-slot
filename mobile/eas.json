{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_EVENTSSLOT_AUTH_MODE": "demo",
        "EXPO_PUBLIC_EVENTSSLOT_UPLOADS_ENABLED": "false",
        "EXPO_PUBLIC_EVENTSSLOT_PUSH_ENABLED": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_EVENTSSLOT_AUTH_MODE": "demo",
        "EXPO_PUBLIC_EVENTSSLOT_UPLOADS_ENABLED": "false",
        "EXPO_PUBLIC_EVENTSSLOT_PUSH_ENABLED": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_EVENTSSLOT_AUTH_MODE": "live",
        "EXPO_PUBLIC_EVENTSSLOT_UPLOADS_ENABLED": "false",
        "EXPO_PUBLIC_EVENTSSLOT_PUSH_ENABLED": "false"
      }
    }
  }
}
